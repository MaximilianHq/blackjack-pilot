{
  "manifest_version": 3,
  "name": "Blackjack Pilot - Live Casino HUD",
  "version": "1.4.4",
  "description": "AI-powered real-time Blackjack HUD overlay with card detection, Hi-Lo counting, and Basic Strategy recommendations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Blackjack Pilot HUD"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ]
}
